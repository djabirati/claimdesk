# Copy this file to .env (never commit .env).

# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Any Gemini model that supports JSON output. Gemini 2.5 models are closed to new users.
LLM_MODEL=gemini-3.8-flash

# Gemini 3 only: low, medium or high. Leave empty for a Gemini 2.5 model.
LLM_THINKING_LEVEL=low

# Only needed when running the backend outside Docker.
DATABASE_URL=postgresql+psycopg://claimdesk:claimdesk@localhost:5432/claimdesk
